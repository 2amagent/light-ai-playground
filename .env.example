# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1               # Change to 0.0.0.0 for network access / self-hosted

# ── Optional features ───────────────────────────────────────────────────────
PERSIST=false                # true = save conversations to conversations.json
AUTO_OPEN_BROWSER=true
LOG_LEVEL=WARNING            # set to DEBUG for full request/tool trace in logs/

# ── LLM defaults ────────────────────────────────────────────────────────────
MAX_TOKENS=4096
TEMPERATURE=0.7

# ── API keys (optional if provided in the New Conversation modal) ────────────
# These are used as fallbacks when no API key is entered in the UI.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# TOGETHERAI_API_KEY=...
# GROQ_API_KEY=...
